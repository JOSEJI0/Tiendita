# Base de datos
DB_PASS=my_secret_password

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# JWT
JWT_SECRET=your_jwt_secret_here

# CORS (separado por comas para múltiples orígenes, SIN espacios extra ni "/" al final)
# IMPORTANTE: debe incluir el/los origenes EXACTOS (scheme+host+puerto) desde donde el
# navegador carga el frontend. Si dejas esta variable sin definir en .env, docker-compose.yml
# usa por defecto http://161.35.108.42:8082 (produccion). Si la defines aqui, ese valor
# SIEMPRE tiene prioridad sobre el default, asi que edítalo con tu origen real:
# CORS_ORIGINS=http://161.35.108.42:8082,http://localhost:5174
